# Copie para .env e preencha localmente; nunca versione credenciais reais.
# Para volumes existentes, use as credenciais já configuradas nos serviços.
LOANS_DB_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Volume novo: rabbitmq. Volume existente: hostname do nó que contém os dados.
# Inspecione antes de recriar o broker; consulte README.md.
RABBITMQ_HOSTNAME=
